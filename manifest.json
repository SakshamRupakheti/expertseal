{
  "manifest_version": 3,
  "name": "ExpertSeal",
  "version": "1.4.0",
  "description": "Research public sources about social-media creators and review credential evidence",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.perplexity.ai/*",
    "https://api.tavily.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://*.tiktok.com/*",
        "https://*.twitter.com/*",
        "https://*.x.com/*"
      ],
      "js": ["lib/identity.js", "lib/report.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "ExpertSeal"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": { "page": "popup/popup.html", "open_in_tab": true },
  "minimum_chrome_version": "114",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; frame-src 'self' about:" }
}
